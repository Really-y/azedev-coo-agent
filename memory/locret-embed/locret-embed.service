[Unit]
Description=LocRet-small local embedding service (for Hermes holographic memory)
Before=hermes-gateway.service

[Service]
ExecStart=%h/.local/share/locret-embed/bin/python %h/.local/share/locret-embed/app/server.py
Environment=HF_HUB_OFFLINE=1
Environment=OMP_NUM_THREADS=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
