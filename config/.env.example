# ~/.hermes/.env — variable names only. Never commit real values.

# Telegram (CEO channel and backup group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# WhatsApp — the agent replies only to these numbers (comma-separated, with country code, no +)
WHATSAPP_ALLOWED_USERS=
# In groups, answer only an @mention / reply / command
WHATSAPP_GROUP_POLICY=allowlist
WHATSAPP_GROUP_ALLOWED_USERS=
WHATSAPP_REQUIRE_MENTION=true

# Task system MCP key (referenced in config.yaml as ${env:KANBA_MCP_TOKEN})
KANBA_MCP_TOKEN=

# Model provider key (depends on the provider you choose)
# <PROVIDER>_API_KEY=
