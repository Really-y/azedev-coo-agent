# ~/.hermes/.env — yalnız dəyişən adları. Real dəyərləri heç vaxt repo-ya yazmayın.

# Telegram (CEO kanalı və yedək qrupu)
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# WhatsApp — yalnız bu nömrələrdən gələn mesajlara cavab verilir (vergüllə, ölkə kodu ilə, + işarəsiz)
WHATSAPP_ALLOWED_USERS=
# Qrupda yalnız @mention / reply / əmrə cavab
WHATSAPP_GROUP_POLICY=allowlist
WHATSAPP_GROUP_ALLOWED_USERS=
WHATSAPP_REQUIRE_MENTION=true

# Task sistemi MCP açarı (config.yaml-da ${env:KANBA_MCP_TOKEN})
KANBA_MCP_TOKEN=

# Model provayderinin açarı (seçdiyiniz provayderə görə)
# <PROVIDER>_API_KEY=
